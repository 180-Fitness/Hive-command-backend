# Local dev: set individual DATABASE_* vars (or DATABASE_URL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=hive_command
# macOS Homebrew Postgres usually uses your Mac username, not "postgres"
DATABASE_USER=your_mac_username
# Leave empty for local trust/peer auth; set if your server requires a password
DATABASE_PASS=
# Render: link Postgres to the web service and use the injected DATABASE_URL instead
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required on first boot to create the enterprise admin account — use a strong unique password
HIVE_ADMIN_PASSWORD=ChangeMe123!

# TV dashboard kiosk password (required — there is no insecure default)
DASHBOARD_WHITERAVEN_PASSWORD=change-me-dashboard-password

PORT=8090
# Optional: FLASK_DEBUG=1 for local interactive debugger only (never in production)
# Optional: ENABLE_HSTS=1 behind HTTPS terminators
# Optional: MAX_UPLOAD_BYTES=15728640

# Production: your hosted frontend URL (comma-separated for multiple origins)
# FRONTEND_URL=https://hive-command.onrender.com

# Day-before shoot SMS (Twilio) — see branch sh/shoot-day-sms-reminders
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# CRON_SECRET=change-me-for-scheduled-reminder-endpoint
